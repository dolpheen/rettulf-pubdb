# rettulf-pubdb collector configuration.
#
# Copy to ops/docker/.env and fill in. The filled file is gitignored — never
# commit a real GITHUB_TOKEN.
#   cp ops/env.example ops/docker/.env

# === Git push auth (publishing collected entries) ===========================
# Token with contents:write on dolpheen/rettulf-pubdb (fine-grained PAT or a
# classic token with `repo`). Used for HTTPS push from inside the container.
# Leave blank and set NO_PUSH=1 for a read-only / dry-run collector.
GITHUB_TOKEN=

# Commit identity for collected entries.
GIT_AUTHOR_NAME=rettulf-pubdb collector
GIT_AUTHOR_EMAIL=collector@users.noreply.github.com

# Collect and commit but never push (1 = dry run). Recommended for first boot.
NO_PUSH=0

# === Daemon tuning ==========================================================
# Port for the daemon's HTTP server (bound to 127.0.0.1 on the host): serves
# /metrics (Prometheus), / (overview page), and /api/status (JSON).
COLLECTOR_PORT=9305

# Concurrent collector threads. Parallelises collection (pub.dev fetch + Dart
# analyze); staging, git commit, and push stay serial. 1 = original behaviour.
WORKERS=4

# Per-request timeout (seconds) for pub.dev discovery and base archive fetches.
PUBDEV_TIMEOUT=60

# Commit buffering: one commit + push per BATCH_SIZE entries, or every
# PUSH_INTERVAL seconds, whichever comes first. Larger BATCH_SIZE = fewer, bigger
# commits (and fewer CI runs), at the cost of re-collecting up to BATCH_SIZE
# entries if the daemon crashes mid-batch.
BATCH_SIZE=100
PUSH_INTERVAL=300

# Per-version Flutter SDK clone location (its own volume; see ops/README.md).
# Provided by docker-compose.yml; override only for a bare-Python deploy.
FLUTTER_CACHE_DIR=/var/cache/rettulf-pubdb/flutter

# === Paths / scope ==========================================================
# Host path to the rettulf-pubdb checkout the collector commits to and pushes
# from. Defaults to the repo containing this compose file.
# REPO_CHECKOUT=/opt/rettulf-pubdb

# Restrict collection to specific packages (space-separated). Empty = the
# db/_top1000.json worklist (refresh it with scripts/refresh_top1000.py).
# PACKAGES=provider dio

# Collect only base entries; skip obfuscated + Flutter-version variants.
# Recommended on the lean image (no Flutter/rettulf), else variant work items
# just dead-letter. Set to 1 for a base-only collector.
BASE_ONLY=0

# === Overview dashboard (optional, behind a TLS + auth reverse proxy) ========
# The daemon serves the read-only overview at / on COLLECTOR_PORT (loopback).
# To expose it publicly, enable the Caddy `proxy` service:
#   1. Point an A record for DASHBOARD_DOMAIN at this host (ports 80+443 open).
#   2. Generate the bcrypt hash:
#        docker run --rm caddy caddy hash-password --plaintext 'your-password'
#   3. Set the three vars below and uncomment COMPOSE_PROFILES.
# COMPOSE_PROFILES=proxy
# DASHBOARD_DOMAIN=collector.example.com
# DASHBOARD_BASIC_AUTH_USER=admin
# DASHBOARD_BASIC_AUTH_HASH=$2a$14$replace_with_caddy_hash_password_output
