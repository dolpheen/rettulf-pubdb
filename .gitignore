# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.env
.mypy_cache/
.ruff_cache/
.pytest_cache/

# Dart / Flutter
.dart_tool/
.packages
pubspec.lock
.flutter-plugins
.flutter-plugins-dependencies
build/

# Collector working data (archives, scratch caches — never commit)
.cache/
collector/_work/
*.tar.gz

# OS / editor
.DS_Store
*.swp
.idea/
.vscode/

# DB entries live under db/<package>/<version>.json — never ignore them, even
# when a package name collides with a build-output pattern above (e.g. the
# pub.dev `build` package vs the `build/` rule). An ignored path in the
# collector's batched `git add` aborts the whole publish and wedges collection.
# (Incident 2026-06-11: the 'build' package stalled commits for ~11h.)
!db/*/
